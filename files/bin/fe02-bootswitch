#!/bin/bash
# fe02-bootswitch: Fe02-OS Variant Switcher

REGISTRY="ghcr.io/m-fe02/fe02-os"
VALID_VARIANTS="gnome gnome-gaming cosmic cosmic-gaming kde kde-gaming"

function show_usage() {
    echo "Fe02-OS Switcher"
    echo "Usage: fe02-bootswitch <variant>"
    echo ""
    echo "Variants:"
    for v in $VALID_VARIANTS; do
        echo "  $v"
    done
}

if [ -z "$1" ]; then
    show_usage
    exit 1
fi

if ! echo "$VALID_VARIANTS" | grep -qw "$1"; then
    echo "Error: Unknown variant '$1'"
    show_usage
    exit 1
fi
TAG="$1"

FULL_IMAGE_PATH="${REGISTRY}:${TAG}"

echo "Preparing switch to Fe02-OS ($TAG)..."
# --enforce-container-sigpolicy isn't sticky across deployments - it has to
# be passed on every switch, or the new deployment silently falls back to
# ostree-unverified-registry even on an already-sealed system.
sudo bootc switch --transport registry --enforce-container-sigpolicy "${FULL_IMAGE_PATH}"

if [ $? -eq 0 ]; then
    echo ""
    echo "Switch staged. Reboot to apply the new image."
    read -p "Reboot now? (y/N): " confirm
    [[ $confirm == [yY] ]] && sudo reboot
else
    echo "Switch failed. Check your network or GHCR access."
fi
